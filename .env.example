# Copy to .env and fill in your keys. NEVER commit the real .env.
# The pipeline reads everything from .env via python-dotenv. Keys are never logged.

# --- secrets (required) ---
ANTHROPIC_API_KEY=sk-ant-...        # Anthropic Console workspace key
TOGETHER_API_KEY=...                # Together AI API key

# --- API endpoints (optional; defaults shown) ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
TOGETHER_BASE_URL=https://api.together.xyz/v1

# --- models (the lineup that produced the paper's results) ---
CLAUDE_MODEL=claude-sonnet-4-6                            # frontier anchor (Anthropic)
TOGETHER_MODEL_1=meta-llama/Llama-3.3-70B-Instruct-Turbo  # same-design comparison (Together)
TOGETHER_MODEL_2=Qwen/Qwen3.5-9B                          # canonical summarizer (Together)

# --- Qwen sampling (applied ONLY to the Qwen slot; thinking is OFF) ---
QWEN_ENABLE_THINKING=false
QWEN_TEMPERATURE=1.0
QWEN_TOP_P=0.95
QWEN_TOP_K=20
QWEN_PRESENCE_PENALTY=1.5

# --- run knobs ---
AGENT_TEMPERATURE=0.7
FILLER_TOKEN_BUDGET=15000
